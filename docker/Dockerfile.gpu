# syntax=docker/dockerfile:1
# WholeBodyPose, GPU image: RTMPose on ONNX Runtime CUDA, ViTPose on CUDA PyTorch, MediaPipe on CPU.
# Needs an NVIDIA driver for CUDA 12 and the NVIDIA Container Toolkit on the host.
#
#   docker build -f docker/Dockerfile.gpu -t wholebodypose:gpu .
#   docker run --rm --gpus all -v "$PWD:/workspace" wholebodypose:gpu \
#       wholebodypose video data/videos/videoTest.mp4 -b rtmpose --device cuda
#
# Build args:
#   CUDA_IMAGE       CUDA 12 + cuDNN 9 runtime base (what onnxruntime-gpu and torch cu12x expect)
#   TORCH_INDEX      PyTorch wheel index matching that CUDA version
#   EXTRAS           pip extras to install (default: all)
#   INSTALL_JUPYTER  "true" adds JupyterLab (run: jupyter lab --ip=0.0.0.0 --no-browser)
ARG CUDA_IMAGE=nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
FROM ${CUDA_IMAGE}

ARG TORCH_INDEX=https://download.pytorch.org/whl/cu126
ARG EXTRAS=all
ARG INSTALL_JUPYTER=false

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# Ubuntu 24.04 ships Python 3.12. git: onepose (vitpose extra); libgl1, libglib2.0-0: MediaPipe's OpenCV.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-venv git libgl1 libegl1 libgles2 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m venv /opt/venv

RUN pip install torch torchvision --index-url "${TORCH_INDEX}"

WORKDIR /opt/wholebodypose
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
# onnxruntime (CPU) and onnxruntime-gpu provide the same module: keep only the GPU build.
RUN pip install ".[${EXTRAS}]" \
    && pip uninstall -y onnxruntime \
    && pip install "onnxruntime-gpu>=1.19" \
    && if [ "$INSTALL_JUPYTER" = "true" ]; then pip install jupyterlab; fi

# The Ubuntu 24.04 CUDA images already have an "ubuntu" user with uid 1000.
RUN mkdir -p /workspace /home/ubuntu/.cache/wholebodypose \
    && chown -R ubuntu:ubuntu /workspace /home/ubuntu/.cache \
    && python -c "import importlib.util as u, pathlib as p; s = u.find_spec('onepose'); \
d = s and p.Path(s.origin).parent / 'models' / 'weights'; d and d.mkdir(parents=True, exist_ok=True); \
d and d.chmod(0o777)"

USER ubuntu
ENV WHOLEBODYPOSE_HOME=/home/ubuntu/.cache/wholebodypose
WORKDIR /workspace

EXPOSE 8888
CMD ["wholebodypose", "--help"]
