# syntax=docker/dockerfile:1
# WholeBodyPose, CPU image: every backend (RTMPose, ViTPose, MediaPipe) + NLMS filters + ffmpeg.
#
#   docker build -f docker/Dockerfile.cpu -t wholebodypose:cpu .
#   docker run --rm -v "$PWD:/workspace" wholebodypose:cpu \
#       wholebodypose image data/images/image.jpg -b mediapipe
#
# Build args:
#   PYTHON_VERSION   Python of the base image (3.10-3.13)
#   EXTRAS           pip extras to install (default: all)
#   INSTALL_JUPYTER  "true" adds JupyterLab (run: jupyter lab --ip=0.0.0.0 --no-browser)
ARG PYTHON_VERSION=3.12
FROM python:${PYTHON_VERSION}-slim

ARG EXTRAS=all
ARG INSTALL_JUPYTER=false

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# git: the vitpose extra installs onepose from GitHub.
# libgl1, libglib2.0-0: MediaPipe depends on the non-headless OpenCV build.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git libgl1 libegl1 libgles2 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# CPU-only PyTorch first, so the vitpose extra does not pull the CUDA wheels.
RUN pip install torch --index-url https://download.pytorch.org/whl/cpu

WORKDIR /opt/wholebodypose
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install ".[${EXTRAS}]" \
    && if [ "$INSTALL_JUPYTER" = "true" ]; then pip install jupyterlab; fi

# Unprivileged user. onepose keeps ViTPose checkpoints inside its package folder, so that folder
# must be writable too.
RUN useradd --create-home --uid 1000 wbp \
    && mkdir -p /workspace /home/wbp/.cache/wholebodypose \
    && chown -R wbp:wbp /workspace /home/wbp/.cache \
    && python -c "import importlib.util as u, pathlib as p; s = u.find_spec('onepose'); \
d = s and p.Path(s.origin).parent / 'models' / 'weights'; d and d.mkdir(parents=True, exist_ok=True); \
d and d.chmod(0o777)"

USER wbp
ENV WHOLEBODYPOSE_HOME=/home/wbp/.cache/wholebodypose
WORKDIR /workspace

EXPOSE 8888
CMD ["wholebodypose", "--help"]
